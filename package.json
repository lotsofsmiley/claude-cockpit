{
  "name": "claudpit",
  "version": "0.3.1",
  "productName": "claudpit",
  "private": true,
  "description": "A Claude Code session cockpit — pwsh tabs, true live survival, Claude-as-operator. Repo: claude-cockpit.",
  "author": "Filipe (lotsofsmiley)",
  "license": "MIT",
  "main": "app/main.js",
  "scripts": {
    "daemon": "node daemon/index.js",
    "start": "electron .",
    "start:dev": "node scripts/dev.js",
    "icons": "node scripts/gen-icons.js",
    "test:survive": "node daemon/test-survive.js",
    "test:state": "node daemon/test-state.js",
    "test:islands": "node daemon/test-islands.js",
    "test:operator": "node daemon/test-operator.mjs",
    "test:restore": "node daemon/test-restore.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.lotsofsmiley.claudpit",
    "productName": "claudpit",
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "daemon/**",
      "mcp/**",
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "lotsofsmiley",
      "repo": "claude-cockpit"
    }
  }
}
